// A straight-line + control-flow integer program — the input the x86-64 backend
// compiles all the way to native machine code.
//
//   cnano --asm examples/asm.cn            # see the generated assembly
//   cnano --asm examples/asm.cn > a.s && cc a.s -o a && ./a   # build + run it
//
// The backend lowers this to the three-address IR, then does real code
// generation: instruction selection (each op -> mov/add/imul/idiv/cmp/…) and
// register allocation (the per-statement temporaries are packed into rbx/r12–r15
// by linear scan, spilling to the stack only when more than five are live).
// Control flow becomes labels and jumps; a loop's state lives in memory
// variables, while only the temporaries are register-allocated. Scope is the
// integer subset; floats, control-flow conditions that aren't booleans, and
// calls need the VM (or the --native C backend).

let a = 2 + 3 * 4;        // precedence: 14
let b = (a * a) - 1;      // 195

print a;
print b;
print b % 7;              // remainder uses idiv
print (a << 2) | 1;       // shifts and bitwise-or

// A loop, compiled to a backward jump (cmp / jl / jmp):
let sum = 0;
let i = 1;
while (i < a) {
  sum = sum + i;          // 1 + 2 + … + 13
  i = i + 1;
}
print sum;                // 91

// Functions compile to real machine functions under the System V calling
// convention — arguments in rdi/rsi/…, result in rax — so recursion runs on the
// hardware call stack with no interpreter at all.
fn fib(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}
print fib(15);            // 610

// Floats compile to SSE2 scalar instructions (addsd / mulsd / ucomisd), held in
// memory slots (the ABI has no callee-saved xmm registers). Printing matches
// the VM exactly — 3.0 prints as "3.0", division by zero as "inf"/"nan".
fn area(radius) {
  return 3.14159 * radius * radius;
}
print area(2.0);          // 12.5664
print 10.0 / 4.0;         // 2.5
print 1.0 / 0.0;          // inf
print 2.0 > 1.5;          // true (booleans print as words)
