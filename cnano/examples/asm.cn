// A straight-line integer program — the input the x86-64 backend compiles.
//
//   cnano --asm examples/asm.cn            # see the generated assembly
//   cnano --asm examples/asm.cn > a.s && cc a.s -o a && ./a   # build + run it
//
// The backend lowers this to the three-address IR, then does real code
// generation: instruction selection (each op -> mov/add/imul/idiv/…) and
// register allocation (the temporaries are packed into rbx/r12–r15 by linear
// scan, spilling to the stack only when more than five are live at once).
// Scope is the integer subset; booleans, floats, control flow and calls need
// the VM (or the --native C backend).

let a = 2 + 3 * 4;        // precedence: 14
let b = (a * a) - 1;      // 195
let c = a + b;            // 209

print a;
print b;
print c;
print c % 7;              // division/remainder use idiv
print (a << 2) | 1;       // shifts and bitwise-or
