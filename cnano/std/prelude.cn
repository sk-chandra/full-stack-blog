// std/prelude.cn — cnano's standard prelude, written in cnano ITSELF.
//
// This file is a milestone: the language is now expressive enough to implement
// its own library. Nothing here is C — every function below runs on the same VM
// as your code, and `import` splices it in like any other module:
//
//     import "std/prelude.cn";   // path relative to YOUR file
//     print gcd(54, 24);         // -> 6
//
// The functions complement the C builtins (str()/len()/abs()/sort()/map()/…):
// they add what the C layer doesn't have — range(), a comparator sort, integer
// exponentiation, predicates over arrays, and string padding.

// ---------------------------------------------------------------------------
// Integers
// ---------------------------------------------------------------------------

// Clamp x into the inclusive range [lo, hi].
fn clamp(x: int, lo: int, hi: int): int {
  if (x < lo) { return lo; }
  if (x > hi) { return hi; }
  return x;
}

// The sign of n: -1, 0, or 1.
fn sign(n: int): int {
  if (n < 0) { return -1; }
  if (n > 0) { return 1; }
  return 0;
}

fn isEven(n: int): bool { return n % 2 == 0; }
fn isOdd(n: int): bool { return n % 2 != 0; }

// Greatest common divisor — Euclid's algorithm, the oldest one in the book.
fn gcd(a: int, b: int): int {
  let x = abs(a);
  let y = abs(b);
  while (y != 0) {
    let t = y;
    y = x % y;
    x = t;
  }
  return x;
}

// Least common multiple, via gcd. (Divide first so the product stays small.)
fn lcm(a: int, b: int): int {
  if (a == 0 or b == 0) { return 0; }
  return abs(a / gcd(a, b) * b);
}

// Integer exponentiation by SQUARING: O(log exp) multiplies instead of O(exp).
// The classic divide-and-conquer trick — b^13 = b^8 * b^4 * b^1, following the
// binary digits of the exponent.
fn ipow(base: int, exp: int): int {
  let result = 1;
  let b = base;
  let e = exp;
  while (e > 0) {
    if (e % 2 == 1) { result = result * b; }
    b = b * b;
    e = e / 2;
  }
  return result;
}

// ---------------------------------------------------------------------------
// Arrays
// ---------------------------------------------------------------------------

// The integers [start, stop) — the canonical loop fuel.
fn range(start: int, stop: int): [int] {
  let out: [int] = [];
  let i = start;
  while (i < stop) {
    out.push(i);
    i = i + 1;
  }
  return out;
}

// Like range, but stepping by `step` (which may be negative).
fn rangeBy(start: int, stop: int, step: int): [int] {
  let out: [int] = [];
  let i = start;
  while ((step > 0 and i < stop) or (step < 0 and i > stop)) {
    out.push(i);
    i = i + step;
  }
  return out;
}

// Sort with a CUSTOM comparator — the builtin .sort() has none. `less(a, b)`
// returns true when a must come before b. Insertion sort: simple, stable, and
// fine at prelude scale; each element sinks left until the order is satisfied.
fn sortBy(xs, less) {
  let i = 1;
  while (i < xs.len()) {
    let j = i;
    while (j > 0 and less(xs[j], xs[j - 1])) {
      let t = xs[j];
      xs[j] = xs[j - 1];
      xs[j - 1] = t;
      j = j - 1;
    }
    i = i + 1;
  }
  return xs;
}

// Does `pred` hold for ANY element? (Stops at the first hit.)
fn any(xs, pred): bool {
  let i = 0;
  while (i < xs.len()) {
    if (pred(xs[i])) { return true; }
    i = i + 1;
  }
  return false;
}

// Does `pred` hold for EVERY element? (Stops at the first miss.)
fn all(xs, pred): bool {
  let i = 0;
  while (i < xs.len()) {
    if (!pred(xs[i])) { return false; }
    i = i + 1;
  }
  return true;
}

// How many elements satisfy `pred`?
fn countIf(xs, pred): int {
  let n = 0;
  let i = 0;
  while (i < xs.len()) {
    if (pred(xs[i])) { n = n + 1; }
    i = i + 1;
  }
  return n;
}

// The index of the first element satisfying `pred`, or -1.
fn findIndex(xs, pred): int {
  let i = 0;
  while (i < xs.len()) {
    if (pred(xs[i])) { return i; }
    i = i + 1;
  }
  return -1;
}

// The distinct elements, first occurrence wins, order preserved.
fn unique(xs) {
  let out = [];
  let i = 0;
  while (i < xs.len()) {
    if (!out.contains(xs[i])) { out.push(xs[i]); }
    i = i + 1;
  }
  return out;
}

// GENERIC helpers (Arc 7): the result type follows the element type, so
// `first([1,2,3])` is an int and `first(["a"])` is a str — checked statically.
fn first<T>(xs: [T]): T { return xs[0]; }
fn last<T>(xs: [T]): T { return xs[xs.len() - 1]; }

// ---------------------------------------------------------------------------
// Strings
// ---------------------------------------------------------------------------

// Pad s on the left with `fill` until it reaches `width` — right-aligning
// numbers in tables is the classic use.
fn padLeft(s: str, width: int, fill: str): str {
  let out = s;
  while (out.len() < width) {
    out = fill + out;
  }
  return out;
}

fn padRight(s: str, width: int, fill: str): str {
  let out = s;
  while (out.len() < width) {
    out = out + fill;
  }
  return out;
}

// Uppercase the first character, leave the rest alone.
fn capitalize(s: str): str {
  if (s.len() == 0) { return s; }
  return s.substring(0, 1).upper() + s.substring(1, s.len());
}

// Reverse a string, one character at a time (strings are immutable, so this
// builds a new one).
fn reverseStr(s: str): str {
  let out = "";
  let i = s.len() - 1;
  while (i >= 0) {
    out = out + s.substring(i, i + 1);
    i = i - 1;
  }
  return out;
}
